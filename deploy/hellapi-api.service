[Unit]
Description=HellAPI FastAPI service
After=network.target

[Service]
Type=simple
User=hellapi
Group=hellapi
WorkingDirectory=/opt/hellapi
EnvironmentFile=/opt/hellapi/.env
Environment=PORT=8000
Environment=DB_PATH=/var/lib/hellapi/bot_data.db
ExecStart=/opt/hellapi/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target