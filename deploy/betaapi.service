[Unit]
Description=BetaAPI combined API and Telegram bot
After=network.target

[Service]
Type=simple
User=betaapi
Group=betaapi
WorkingDirectory=/opt/betaapi
EnvironmentFile=/opt/betaapi/.env
Environment=PORT=8000
Environment=DB_PATH=/var/lib/betaapi/bot_data.db
ExecStart=/opt/betaapi/.venv/bin/python start.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
