[Unit]
Description=HellAPI Telegram bot
After=network.target hellapi-api.service
Wants=hellapi-api.service

[Service]
Type=simple
User=hellapi
Group=hellapi
WorkingDirectory=/opt/hellapi
EnvironmentFile=/opt/hellapi/.env
Environment=API_BASE_URL=http://127.0.0.1:8000
Environment=DB_PATH=/var/lib/hellapi/bot_data.db
ExecStart=/opt/hellapi/.venv/bin/python tgbot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target