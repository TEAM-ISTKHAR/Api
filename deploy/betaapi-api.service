[Unit]
Description=BetaAPI FastAPI service
After=network.target

[Service]
Type=simple
User=betaapi
Group=betaapi
WorkingDirectory=/opt/betaapi
EnvironmentFile=/opt/betaapi/.env
Environment=PORT=8000
Environment=DB_PATH=/var/lib/betaapi/bot_data.db
ExecStart=/opt/betaapi/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target