# ============================================================
# .env.example — Copy to .env and fill in your values
# ============================================================

# ── Server ───────────────────────────────────────────────────
APP_NAME=BetaAPI
PORT=8000
WORKERS=1
APP_URL=https://your-public-api.example.com
API_BASE_URL=http://localhost:8000
DB_PATH=./data/bot_data.db
ADMIN_KEY=replace_with_a_long_random_admin_key

# ── Telegram Bot ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token
BOT_NAME=BetaAPI
ADMIN_IDS=your_telegram_id
SUPPORT_GROUP=https://t.me/yoursupport
CHANNEL=https://t.me/yourchannel
BOT_URL=

# ── Payment ──────────────────────────────────────────────────
UPI_ID=yourname@upi
UPI_NAME=BetaAPI
BANK_NAME=
BANK_ACCOUNT=
BANK_IFSC=

# ── YouTube networking ───────────────────────────────────────
# Proxy routing is disabled for Heroku reliability. Direct requests
# use retries and fallback routes instead of PROXY_LIST.

# ── yt-dlp tuning ────────────────────────────────────────────
YTDLP_MIN_SLEEP=0.1
YTDLP_MAX_SLEEP=0.4
YTDLP_MAX_RETRIES=3
YTDLP_WORKERS=6
YTDLP_CACHE_TTL=480
YTDLP_CACHE_SIZE=256
YTDLP_COOKIE_FILE=
YTDLP_PO_TOKEN=

# ── Security ─────────────────────────────────────────────────
BF_MAX_ATTEMPTS=10
BF_WINDOW_SEC=60
BF_BLOCK_SEC=300

# ── DB Cache ─────────────────────────────────────────────────
VIDEO_CACHE_TTL_DAYS=7
