# ============================================================
# .env.example — Copy to .env and fill in your values
# ============================================================

# ── Server ───────────────────────────────────────────────────
APP_NAME=HellAPI
PORT=8000
APP_URL=http://YOUR_VPS_IP:8000
API_BASE_URL=http://localhost:8000
ADMIN_KEY=your_strong_admin_password

# ── Telegram Bot ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token
BOT_NAME=HellAPI
ADMIN_IDS=your_telegram_id
SUPPORT_GROUP=https://t.me/yoursupport
CHANNEL=https://t.me/yourchannel
BOT_URL=

# ── Payment ──────────────────────────────────────────────────
UPI_ID=yourname@upi
UPI_NAME=HellAPI
BANK_NAME=
BANK_ACCOUNT=
BANK_IFSC=

# ── Proxy (recommended for YouTube unblock) ──────────────────
# Format: http://user:pass@ip:port
# Multiple: http://u:p@ip1:port,http://u:p@ip2:port
PROXY_LIST=

# ── yt-dlp tuning ────────────────────────────────────────────
YTDLP_MIN_SLEEP=0.5
YTDLP_MAX_SLEEP=2.0
YTDLP_MAX_RETRIES=2
YTDLP_WORKERS=4
YTDLP_CACHE_TTL=480
YTDLP_CACHE_SIZE=256
YTDLP_COOKIE_FILE=
YTDLP_PO_TOKEN=

# ── Security ─────────────────────────────────────────────────
BF_MAX_ATTEMPTS=10
BF_WINDOW_SEC=60
BF_BLOCK_SEC=300

# ── DB Cache ─────────────────────────────────────────────────
VIDEO_CACHE_TTL_DAYS=7
